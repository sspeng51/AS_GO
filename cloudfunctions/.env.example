# 这些变量需要在微信云开发控制台分别配置到对应云函数，不会自动从本文件加载。

# processKnowledge
# 专家回答规范：需与独立流式服务使用一致值，默认启用。
EXPERT_POLICY_ENABLED=true
ZHIPU_API_KEY=your-zhipu-api-key
GUEST_DAILY_LIMIT=10
GUEST_PER_MINUTE_LIMIT=5
REGISTERED_DAILY_LIMIT=100
REGISTERED_PER_MINUTE_LIMIT=10
STREAM_SHARED_SECRET=replace-with-the-same-32-plus-character-secret-as-web-admin
ZHIPU_KNOWLEDGE_ID=2100852235595599872
ALLOWED_CHAT_MODELS=glm-5.3,glm-5.3-flash,glm-4.7-flashx,glm-4.7-flash
ALLOW_MODEL_OVERRIDE=false
NEO4J_URI=neo4j+s://8785b1b2.databases.neo4j.io
NEO4J_USERNAME=8785b1b2
NEO4J_PASSWORD=
NEO4J_DATABASE=8785b1b2

# wechatLogin / processKnowledge（仅本地联调允许开启）
ALLOW_DEV_LOGIN=false

# chatConversation（跨用户管理 CRUD 的独立密钥，至少 32 位）
CHAT_CONVERSATION_ADMIN_SECRET=replace-with-at-least-32-random-characters
USER_CONSISTENCY_CHECK_SECRET=replace-with-at-least-32-random-characters

# mediaProcess
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 后台切换测试知识库的请求签名；两端须相同，留空复用 STREAM_SHARED_SECRET
RAG_TUNING_SHARED_SECRET=
AURA_INSTANCEID=8785b1b2
AURA_INSTANCENAME=Free instance
