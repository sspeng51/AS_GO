.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(110rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  border-top: 1rpx solid rgba(10, 61, 98, 0.08);
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -4rpx 24rpx rgba(10, 61, 98, 0.06);
  z-index: 999;
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-item.active {
  transform: scale(1.05);
}

.tab-icon {
  font-size: 44rpx;
  margin-bottom: 4rpx;
  transition: all 0.3s ease;
  opacity: 0.55;
}

.tab-item.active .tab-icon {
  opacity: 1;
  transform: translateY(-2rpx);
}

.tab-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #94a3b8;
  letter-spacing: 0.5rpx;
  transition: all 0.3s ease;
}

.tab-item.active .tab-text {
  color: #0A3D62;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  top: 16rpx;
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #0A3D62 0%, #455f88 100%);
  border-radius: 3rpx;
  opacity: 0;
  transform: scaleX(0);
  transition: all 0.3s ease;
}

.tab-item.active .tab-indicator {
  opacity: 1;
  transform: scaleX(1);
}

/* AI 思考中红点指示器 */
.streaming-dot {
  position: absolute;
  top: 14rpx;
  right: 50%;
  margin-right: -36rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ef4444;
  box-shadow: 0 0 0 2rpx #fff, 0 2rpx 6rpx rgba(239, 68, 68, 0.5);
  z-index: 2;
}

.streaming-pulse {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: #ef4444;
  animation: tabbar-pulse 1.4s ease-out infinite;
}

@keyframes tabbar-pulse {
  0% { transform: scale(1); opacity: 0.8; }
  100% { transform: scale(2.6); opacity: 0; }
}

/* 思考中时对话图标轻微抖动，吸引注意 */
.tab-item.has-streaming .tab-icon {
  animation: tabbar-bounce 1.6s ease-in-out infinite;
}

@keyframes tabbar-bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-3rpx); }
}

/* 深色模式适配 */
.dark-theme .custom-tabbar {
  background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
  border-top-color: #334155;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.3);
}

.dark-theme .tab-text {
  color: #64748b;
}

.dark-theme .tab-item.active .tab-text {
  color: #93c5fd;
}