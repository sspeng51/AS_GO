{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "envId": "cloud1-6gbzplmt4a3dc5b5",
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "processKnowledge",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 120,
      "memorySize": 512,
      "installDependency": true
    },
    {
      "name": "wechatLogin",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 15,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "feedback",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 15,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "mediaProcess",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 60,
      "memorySize": 512,
      "installDependency": true
    },
    {
      "name": "chatConversation",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 15,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "userConsistencyCheck",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 60,
      "memorySize": 256,
      "installDependency": true,
      "triggers": [
        {
          "name": "dailyCheck",
          "type": "timer",
          "config": "0 0 3 * * * *"
        }
      ]
    }
  ]
}
