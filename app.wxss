page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #faf9fd;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  color: #1a1a2e;
}

view {
  box-sizing: border-box;
}

text {
  word-break: break-word;
}

button::after {
  border: none;
}

/* 全局滚动优化 */
scroll-view {
  -webkit-overflow-scrolling: touch;
}

/* 安全区域适配 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 全局淡入动画 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.fade-in {
  animation: fadeIn 0.3s ease;
}

/* ============================================================
   全局深色模式适配
   ============================================================ */
page.dark-theme {
  background-color: #0f172a;
  color: #e2e8f0;
}

/* 通用暗色覆盖 */
.dark-theme .container,
.dark-theme .profile-container,
.dark-theme .page-container {
  background: #0f172a !important;
}

/* 搜索输入框 - 暗色 */
.dark-theme .search-input {
  background: #1e293b !important;
  border-color: #334155 !important;
  color: #e2e8f0 !important;
}

/* 按钮边框重置 - 暗色 */
.dark-theme button {
  background: transparent;
}

/* 卡片暗色 */
.dark-theme .card,
.dark-theme .auth-card,
.dark-theme .chart-wrapper {
  background: #1e293b !important;
}

/* 文字颜色暗色 */
.dark-theme .text-primary { color: #e2e8f0 !important; }
.dark-theme .text-secondary { color: #94a3b8 !important; }
.dark-theme .text-muted { color: #64748b !important; }


