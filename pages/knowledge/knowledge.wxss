/* ============================================================
   我的知识库 - 个人 KB 页面样式
   主题：浅色 #faf9fd / 深色 #0f172a
   强调色：海军蓝渐变 #0A3D62 → #1a365d（与首页一致）
   ============================================================ */

.kb-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #faf9fd;
  color: #1a1c1e;
  padding-bottom: 120rpx; /* 给 tab-bar 留位 */
}

/* ============ 顶部 Tab ============ */
.tab-header {
  display: flex;
  background: #ffffff;
  padding: 0 40rpx;
  height: 96rpx;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 64rpx;
  border-radius: 32rpx;
  font-size: 30rpx;
  color: #64748b;
  transition: all 0.25s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, #0A3D62, #1a365d);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(10, 61, 98, 0.25);
}

.tab-icon { font-size: 32rpx; }
.tab-label { font-size: 28rpx; }

/* ============ 文档视图 ============ */
.docs-view {
  flex: 1;
  padding: 24rpx 28rpx 0;
}

/* 统计卡 */
.stats-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.stat-card {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(10, 61, 98, 0.06);
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #0A3D62;
  line-height: 1.1;
}

.stat-lbl {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

/* 上传按钮 */
.upload-row { margin-bottom: 24rpx; }

.upload-btn {
  background: linear-gradient(135deg, #0A3D62, #1a365d);
  color: #ffffff;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(10, 61, 98, 0.2);
  transition: transform 0.15s ease;
}

.upload-btn:active { transform: scale(0.98); }

.upload-plus {
  font-size: 36rpx;
  font-weight: 400;
  line-height: 1;
}

/* 引导提示 */
.upload-guide {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 20rpx;
  padding: 16rpx 24rpx;
  background: #eff6ff;
  border-radius: 14rpx;
  border-left: 6rpx solid #0A3D62;
}

.guide-icon {
  font-size: 26rpx;
  flex-shrink: 0;
  line-height: 1.6;
}

.guide-text {
  font-size: 25rpx;
  color: #475569;
  line-height: 1.6;
}

/* 分类筛选 */
.category-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.cat-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: #ffffff;
  color: #64748b;
  font-size: 26rpx;
  border-radius: 28rpx;
  border: 2rpx solid #e2e8f0;
  transition: all 0.2s ease;
}

.cat-chip.active {
  background: #0A3D62;
  color: #ffffff;
  border-color: #0A3D62;
}

/* 标签筛选 */
.tag-filter-wrap {
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tag-filter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tf-title {
  font-size: 26rpx;
  color: #475569;
  font-weight: 500;
}

.tf-arrow {
  font-size: 24rpx;
  color: #94a3b8;
  transition: transform 0.25s ease;
  display: inline-block;
}

.tf-arrow.expanded { transform: rotate(180deg); }

.tag-filter-body {
  margin-top: 20rpx;
}

.tag-mode-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.tag-mode-btn {
  font-size: 24rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
}

.tag-mode-btn.active {
  color: #0A3D62;
  background: #eff6ff;
  border-color: #bfdbfe;
  font-weight: 600;
}

.tag-clear-btn {
  font-size: 24rpx;
  color: #ef4444;
  padding: 10rpx 20rpx;
}

.tag-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-chip {
  font-size: 24rpx;
  color: #0A3D62;
  background: #eff6ff;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.tag-chip.active {
  background: #0A3D62;
  color: #ffffff;
  border-color: #0A3D62;
}

.tag-chip .tag-count {
  font-size: 20rpx;
  opacity: 0.7;
  padding-left: 4rpx;
}

/* 文档列表 */
.doc-list { padding-bottom: 40rpx; }

.doc-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s ease;
}

.doc-card:active { transform: scale(0.99); }

.doc-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  background: #f1f5f9;
}

.icon-pdf { background: #fef2f2; }
.icon-doc { background: #eff6ff; }
.icon-text { background: #f0fdf4; }
.icon-image { background: #fdf4ff; }
.icon-data { background: #fffbeb; }

.doc-body {
  flex: 1;
  min-width: 0;
}

.doc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1c1e;
  line-height: 1.4;
  word-break: break-word;
  margin-bottom: 10rpx;
}

.doc-meta {
  font-size: 24rpx;
  color: #94a3b8;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.meta-cat { color: #0A3D62; font-weight: 500; }
.meta-dot { color: #cbd5e1; }

.doc-tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.doc-tag {
  font-size: 22rpx;
  color: #0A3D62;
  background: #eff6ff;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.doc-status {
  margin-top: 12rpx;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  display: inline-block;
}

.status-processing { background: #fef3c7; color: #92400e; }
.status-failed { background: #fee2e2; color: #991b1b; }
.status-warn { background: #e0e7ff; color: #3730a3; }

.doc-del {
  font-size: 24rpx;
  color: #ef4444;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: #fef2f2;
  flex-shrink: 0;
}

.doc-del:active { background: #fee2e2; }

/* 空状态 / 加载 */
.empty-state {
  padding: 100rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  color: #94a3b8;
}

.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 30rpx; color: #64748b; text-align: center; word-break: break-word; }
.empty-hint { font-size: 24rpx; color: #cbd5e1; text-align: center; }

.error-state .empty-icon { color: #ef4444; }
.error-state .empty-text { color: #dc2626; }

.retry-btn {
  margin-top: 16rpx;
  padding: 16rpx 40rpx;
  font-size: 26rpx;
  color: #0A3D62;
  background: #eff6ff;
  border-radius: 32rpx;
  border: 2rpx solid #bfdbfe;
}

.retry-btn:active { background: #bfdbfe; transform: scale(0.96); }

/* 骨架屏 */
.skeleton-card { pointer-events: none; }

.skeleton-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.skeleton-body { flex: 1; display: flex; flex-direction: column; gap: 12rpx; }

.skeleton-line {
  height: 24rpx;
  border-radius: 8rpx;
}

.skeleton-shimmer {
  background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* fade-in 入场动画 */
.fade-in {
  animation: fadeInUp 0.3s ease;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.loading-more, .no-more {
  text-align: center;
  font-size: 24rpx;
  color: #cbd5e1;
  padding: 24rpx 0;
}

/* ============ 问答视图 ============ */
.qa-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.qa-toolbar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 28rpx;
  background: #ffffff;
}

.toolbar-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #0A3D62;
  background: #eff6ff;
  padding: 14rpx 0;
  border-radius: 14rpx;
}

.toolbar-btn:active { background: #dbeafe; }

/* 历史面板 */
.history-panel {
  background: #ffffff;
  margin: 0 28rpx 16rpx;
  border-radius: 16rpx;
  padding: 12rpx 0;
  max-height: 480rpx;
  overflow-y: auto;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.history-empty {
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
  padding: 40rpx 0;
}

/* 历史面板标题栏 */
.hp-title-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.hp-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #475569;
  flex: 1;
}

.hp-count {
  font-size: 22rpx;
  color: #94a3b8;
  background: #f1f5f9;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.hp-back {
  font-size: 28rpx;
  color: #0A3D62;
  padding: 4rpx 12rpx 4rpx 0;
}

/* 会话项 */
.session-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #f1f5f9;
  gap: 12rpx;
}

.session-item:last-child { border-bottom: none; }

.si-main { flex: 1; min-width: 0; }

.si-title {
  font-size: 28rpx;
  color: #1a1c1e;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.si-meta {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
  display: flex;
  gap: 6rpx;
}

.si-dot { color: #cbd5e1; }

.si-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.si-resume {
  font-size: 22rpx;
  color: #0A3D62;
  background: #eff6ff;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.si-resume:active { background: #bfdbfe; }

.si-del {
  color: #cbd5e1;
  font-size: 28rpx;
  padding: 8rpx 12rpx;
}

.si-del:active { color: #ef4444; }

.history-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.history-item:last-child { border-bottom: none; }

.hi-main { flex: 1; min-width: 0; }

.hi-q {
  font-size: 28rpx;
  color: #1a1c1e;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hi-time {
  font-size: 22rpx;
  color: #cbd5e1;
  margin-top: 6rpx;
}

.hi-del {
  color: #cbd5e1;
  font-size: 28rpx;
  padding: 10rpx 16rpx;
}

.hi-del:active { color: #ef4444; }

/* 消息区 */
.msg-scroll {
  flex: 1;
  padding: 20rpx 28rpx calc(260rpx + env(safe-area-inset-bottom)); /* 留白给输入栏+tab-bar */
  min-height: 0;
}

.qa-welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  gap: 16rpx;
  color: #94a3b8;
  padding-right: 30px;
}

.welcome-icon { font-size: 100rpx; }
.welcome-title { font-size: 34rpx; font-weight: 600; color: #475569; }
.welcome-desc { font-size: 26rpx; color: #94a3b8; text-align: center; }
.welcome-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #f59e0b;
  background: #fffbeb;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
}

/* ============ 消息行（与首页一致） ============ */
.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-bottom: 32rpx;
  padding-right: 20px;
  animation: messageIn 0.4s ease-out;
}

@keyframes messageIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.msg-user {
  flex-direction: row-reverse;
  justify-content: flex-end;
  padding-right: 20px;
  padding-top: 5px;
}

/* 头像 */
.msg-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 42rpx;
}

.msg-avatar-user {
  background-color: #e2e8f0;
  border: 2rpx solid #cbd5e1;
  position: relative;
  overflow: hidden;
}

.msg-avatar-ai {
  background: linear-gradient(135deg, #0A3D62 0%, #1a365d 100%);
  box-shadow: 0 6rpx 16rpx rgba(10, 61, 98, 0.25);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 42rpx;
}

/* 消息内容 */
.msg-content {
  max-width: 78%;
  display: flex;
  flex-direction: column;
}

.msg-user .msg-content { align-items: flex-end; }

.msg-bubble {
  padding: 28rpx 32rpx;
  border-radius: 28rpx;
  font-size: 29rpx;
  line-height: 1.65;
  word-wrap: break-word;
  word-break: break-word;
}

.bubble-user {
  background: linear-gradient(135deg, #0A3D62 0%, #1a365d 100%);
  color: #ffffff;
  border-top-right-radius: 10rpx;
  box-shadow: 0 6rpx 20rpx rgba(10, 61, 98, 0.2);
}

.bubble-ai {
  background-color: #ffffff;
  color: #1a1c1e;
  border-top-left-radius: 10rpx;
  border: 1rpx solid #e8ecf0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.content-text {
  display: block;
  white-space: pre-wrap;
  line-height: 1.7;
}

/* 参考来源 */
.msg-sources {
  margin-top: 12rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  border-left: 6rpx solid #0A3D62;
}

.src-title {
  font-size: 24rpx;
  color: #0A3D62;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.src-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #64748b;
  padding: 6rpx 0;
  gap: 12rpx;
}

.src-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.src-score {
  color: #94a3b8;
  font-size: 22rpx;
  flex-shrink: 0;
}

/* 打字动画 */
.typing {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.typing-dot {
  font-size: 40rpx;
  color: #0A3D62;
  animation: blink 1.4s infinite both;
  line-height: 0.5;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 80%, 100% { opacity: 0.2; }
  40% { opacity: 1; }
}

.msg-bottom-anchor { height: 1rpx; }

/* 底部输入 */
/* ============ 底部输入栏（与首页一致） ============ */
.qa-input-section {
  position: fixed;
  bottom: calc(110rpx + env(safe-area-inset-bottom)); /* 抬高到 tab-bar 上方 */
  left: 0;
  right: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, #ffffff 100%);
  backdrop-filter: blur(24rpx);
  padding: 18rpx 28rpx 14rpx;
  border-top: 2rpx solid #f1f5f9;
  z-index: 50;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.03);
}

.qa-input-container {
  position: relative;
  background: #ffffff;
}

.qa-input-wrapper {
  display: flex;
  align-items: flex-end;
  background-color: #f1f5f9;
  border-radius: 36rpx;
  padding: 8rpx 8rpx 8rpx 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
  flex: 1;
  min-width: 0;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.qa-input-wrapper:focus-within {
  background-color: #ffffff;
  border-color: rgba(10, 61, 98, 0.35);
  box-shadow: 0 0 0 4rpx rgba(10, 61, 98, 0.08);
}

.qa-input-field {
  flex: 1;
  min-width: 0;
  background-color: transparent;
  font-size: 32rpx;
  color: #1a1c1e;
  min-height: 56rpx;
  max-height: 160rpx;
  line-height: 1.5;
  padding: 8rpx 10rpx;
}

.qa-input-ph { color: #94a3b8; }

.qa-send-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #cbd5e1;
  border-radius: 50%;
  flex-shrink: 0;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.qa-send-btn.active {
  background: linear-gradient(135deg, #0A3D62 0%, #1a365d 100%);
  box-shadow: 0 4rpx 16rpx rgba(10, 61, 98, 0.3);
  transform: scale(1.05);
}

.qa-send-btn.active:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.qa-send-icon {
  font-size: 38rpx;
  color: #ffffff;
  font-weight: bold;
}

.qa-send-btn:not(.active) .qa-send-icon {
  color: #94a3b8;
}

/* ============ 上传弹窗 ============ */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}

.modal-content {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1c1e;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-body { margin-bottom: 32rpx; }

.form-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
  gap: 20rpx;
}

.form-label {
  width: 100rpx;
  font-size: 28rpx;
  color: #64748b;
  padding-top: 16rpx;
  flex-shrink: 0;
}

.form-control { flex: 1; min-width: 0; }

.picker-btns {
  display: flex;
  gap: 16rpx;
}

.pick-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #0A3D62;
  background: #eff6ff;
  padding: 24rpx 0;
  border-radius: 14rpx;
  border: 2rpx dashed #93c5fd;
}

.pick-btn:active { background: #dbeafe; }

.file-chosen {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #eff6ff;
  padding: 24rpx;
  border-radius: 14rpx;
  gap: 16rpx;
}

.file-name {
  flex: 1;
  font-size: 28rpx;
  color: #1a1c1e;
  word-break: break-all;
}

.file-clear {
  color: #ef4444;
  font-size: 32rpx;
  padding: 4rpx 12rpx;
}

.picker-value {
  font-size: 28rpx;
  color: #1a1c1e;
  background: #eff6ff;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
}

.form-input {
  font-size: 28rpx;
  color: #1a1c1e;
  background: #eff6ff;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
}

.form-input-ph { color: #cbd5e1; }

/* 进度条 */
.progress-wrap {
  margin: 16rpx 0 24rpx;
}

.progress-bar {
  height: 16rpx;
  background: #e2e8f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #0A3D62, #1a365d);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #64748b;
  margin-top: 10rpx;
}

.form-tip {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
  background: #f8fafc;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
}

/* 弹窗底部按钮 */
.modal-footer {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.modal-btn.cancel {
  background: #f1f5f9;
  color: #64748b;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #0A3D62, #1a365d);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(10, 61, 98, 0.2);
}

.modal-btn.confirm.disabled {
  background: #e2e8f0;
  color: #cbd5e1;
  box-shadow: none;
}

/* ============ 文档详情弹窗 ============ */
.detail-content {
  max-height: 86vh;
  overflow-y: auto;
}

.detail-loading {
  padding: 60rpx 0;
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
}

.detail-empty {
  padding: 40rpx 0;
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
}

.detail-header {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
  margin-bottom: 24rpx;
}

.detail-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  background: #f1f5f9;
}

.detail-info { flex: 1; min-width: 0; }

.detail-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1c1e;
  line-height: 1.4;
  word-break: break-word;
  margin-bottom: 10rpx;
}

.detail-meta {
  font-size: 24rpx;
  color: #94a3b8;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-bottom: 6rpx;
}

.status-ready {
  background: #dcfce7;
  color: #166534;
}

.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.detail-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 18rpx 0;
  border-radius: 14rpx;
}

.detail-btn.reprocess {
  color: #0A3D62;
  background: #eff6ff;
  border: 2rpx solid #bfdbfe;
}

.detail-btn.reprocess:active { background: #bfdbfe; }

.detail-btn.reprocess.disabled {
  color: #cbd5e1;
  background: #f1f5f9;
  border-color: #e2e8f0;
}

.detail-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 16rpx;
}

.chunk-card {
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
  border-left: 6rpx solid #1a365d;
}

.chunk-idx {
  font-size: 22rpx;
  color: #1a365d;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.chunk-text {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.55;
  word-break: break-word;
  white-space: pre-wrap;
}

.chunk-pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  margin-top: 8rpx;
}

.pager-btn {
  font-size: 26rpx;
  color: #0A3D62;
  padding: 12rpx 24rpx;
  background: #eff6ff;
  border-radius: 14rpx;
}

.pager-btn.disabled {
  color: #cbd5e1;
  background: #f1f5f9;
}

.pager-info {
  font-size: 24rpx;
  color: #94a3b8;
}

/* ============ 深色模式 ============ */
.dark-theme.kb-page,
.dark-theme .kb-page {
  background: #0f172a !important;
  color: #e2e8f0 !important;
}

.dark-theme .tab-header {
