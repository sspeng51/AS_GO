PORT=3000
# 必须修改为高强度随机字符串（至少 16 位），否则服务将拒绝启动
JWT_SECRET=replace-with-at-least-32-random-characters
CLOUDBASE_ENV_ID=cloud1-6gbzplmt4a3dc5b5
CLOUDBASE_SECRET_ID=your-tencent-cloud-secret-id
CLOUDBASE_SECRET_KEY=your-tencent-cloud-secret-key
# 内置管理员账号（建议配置后尽快在数据库中创建真实管理员并移除环境变量）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 首次部署：配置上面两项后运行 npm run create-admin，成功后移除 ADMIN_PASSWORD。

# 微信小程序配置（上线前替换为真实的 AppID 和 AppSecret）
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret
# 仅限本地调试；生产环境必须保持 false
ALLOW_DEV_LOGIN=false

# 智谱 API（流式对话代理使用，与云函数共用同一 Key）
# 专家回答规范：需与 processKnowledge 使用一致值，默认启用。
EXPERT_POLICY_ENABLED=true
ZHIPU_API_KEY=your-zhipu-api-key
# 智谱控制台创建的托管知识库 ID（不能随机生成）
ZHIPU_KNOWLEDGE_ID=2100852235595599872

# 流式接口签名密钥（与 processKnowledge 云函数相同，至少 32 位）
STREAM_SHARED_SECRET=replace-with-at-least-32-random-characters
CHAT_STREAM_TIMEOUT_MS=100000

# 生产管理端域名，多个值以逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 后台切换测试知识库的请求签名；两端须相同，留空复用 STREAM_SHARED_SECRET
RAG_TUNING_SHARED_SECRET=
NEO4J_URI=neo4j+s://8785b1b2.databases.neo4j.io
NEO4J_USERNAME=8785b1b2
NEO4J_PASSWORD=
NEO4J_DATABASE=8785b1b2
AURA_INSTANCEID=8785b1b2
AURA_INSTANCENAME=Free instance

# Five-group experiments: per-process model cap, question workers, group workers
ANSWER_MODEL_CONCURRENCY=4
ANSWER_QUESTION_CONCURRENCY=2
ANSWER_GENERATION_CONCURRENCY=3
